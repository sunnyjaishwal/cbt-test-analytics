# =====================================================================
# Environment configuration for cbt-test-analytics (dbt + Postgres)
# Copy to `.env` and adjust.  `.env` is git-ignored.
#
#   cp .env.example .env
# =====================================================================

# Tell dbt to read profiles.yml from the project root (this repo).
DBT_PROFILES_DIR=.

# ---------------------------------------------------------------------
# Choose the connection: `local` (Docker) or `server` (remote host).
# ---------------------------------------------------------------------
DBT_TARGET=local

# ---------------------------------------------------------------------
# LOCAL (Docker) defaults — these also configure docker-compose.yml.
# ---------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=dbt
PG_PASSWORD=dbt
PG_DATABASE=analytics
PG_SCHEMA=public
PG_SSLMODE=disable

# ---------------------------------------------------------------------
# SERVER example — set DBT_TARGET=server and fill these in.
# (For server, PG_SSLMODE typically = require.)
# ---------------------------------------------------------------------
# DBT_TARGET=server
# PG_HOST=db.internal.example.com
# PG_PORT=5432
# PG_USER=analytics_svc
# PG_PASSWORD=change-me
# PG_DATABASE=analytics
# PG_SCHEMA=public
# PG_SSLMODE=require

# ---------------------------------------------------------------------
# dbt runtime
# ---------------------------------------------------------------------
DBT_THREADS=4
