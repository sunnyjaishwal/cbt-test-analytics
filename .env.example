# Copy to `.env` (git-ignored) and fill in real values. No secrets in this file.
DBT_PROFILES_DIR=.
DBT_TARGET=server

PG_HOST=your-service.aivencloud.com
PG_PORT=5432
PG_USER=your_user
PG_PASSWORD=__REPLACE_WITH_YOUR_PASSWORD__
PG_DATABASE=defaultdb
PG_SCHEMA=public
PG_SSLMODE=require

DBT_THREADS=8

# AWS (only if using s3-aws-test.py) — read from env, never hardcode.
# AWS_ACCESS_KEY_ID=__REPLACE_ME__
# AWS_SECRET_ACCESS_KEY=__REPLACE_ME__
# AWS_REGION=us-east-1
